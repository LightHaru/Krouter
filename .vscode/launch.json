{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceRoot}",
      "program": "${workspaceRoot}/out-server/server/index.js",
      "args": ["--api-only"],
      "env": {
        "PORT": "4010"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Fullstack Server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceRoot}",
      "program": "${workspaceRoot}/out-server/server/index.js",
      "env": {
        "PORT": "4010"
      },
      "console": "integratedTerminal"
    }
  ]
}
